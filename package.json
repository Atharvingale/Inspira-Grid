{
  "name": "inspira-grid",
  "version": "1.0.0",
  "description": "A full-stack collaborative platform for students, creators, and developers",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm start",
    "server:install": "cd server && npm install",
    "client:install": "cd client && npm install",
    "install-all": "npm install && npm run server:install && npm run client:install",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "setup": "npm run copy-env && npm run install-all",
    "copy-env": "echo 'Copy env script not implemented'",
    "check-env": "echo 'Check env script not implemented'",
    "generate-secrets": "echo 'Generate secrets script not implemented'"
  },
  "keywords": [
    "collaboration",
    "students",
    "projects",
    "teams",
    "react",
    "nodejs",
    "firebase"
  ],
  "author": "Inspira-Grid Team",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "19.1.13",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "firebase": "^12.3.0",
    "postcss": "^8.5.6",
    "react-firebase-hooks": "^5.1.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.13"
  }
}
