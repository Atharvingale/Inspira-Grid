<%- include('partials/header', {title: `Team: ${team.team_name}`, currentPage: 'teams'}) %>

<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="card-title mb-0"><%= team.team_name %></h2>
            <% if (team.isMember) { %>
              <span class="badge bg-success">You're a member</span>
            <% } %>
          </div>
          
          <p class="text-muted">
            <i class="fas fa-briefcase me-2"></i>Project: <a href="/projects/<%= team.project_id %>"><%= team.project_name %></a>
          </p>
          
          <% if (team.description) { %>
            <div class="mb-3">
              <h5>About this team</h5>
              <p><%= team.description %></p>
            </div>
          <% } %>
          
          <% if (team.skills && team.skills.length > 0) { %>
            <div class="mb-3">
              <h5>Skills</h5>
              <div class="d-flex flex-wrap gap-2">
                <% team.skills.forEach(skill => { %>
                  <span class="badge bg-primary"><%= skill.skill_name %></span>
                <% }); %>
              </div>
            </div>
          <% } %>
          
          <div class="d-flex justify-content-between mt-4">
            <% if (!team.isMember) { %>
              <button class="btn btn-primary join-team-btn" data-team-id="<%= team.team_id %>">
                <i class="fas fa-user-plus me-2"></i>Join Team
              </button>
            <% } else if (team.userRole !== 'Project Lead') { %>
              <button class="btn btn-outline-danger leave-team-btn" data-team-id="<%= team.team_id %>">
                <i class="fas fa-sign-out-alt me-2"></i>Leave Team
              </button>
            <% } %>
            
            <% if (team.leader_id === user.user_id) { %>
              <div>
                <a href="/teams/<%= team.team_id %>/edit" class="btn btn-outline-primary me-2">
                  <i class="fas fa-edit me-2"></i>Edit Team
                </a>
                <button class="btn btn-outline-danger delete-team-btn" data-team-id="<%= team.team_id %>">
                  <i class="fas fa-trash me-2"></i>Delete Team
                </button>
              </div>
            <% } %>
          </div>
        </div>
      </div>
      
      <!-- Team Members Section -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
          <h4 class="mb-0">Team Members</h4>
        </div>
        <div class="card-body">
          <div class="row">
            <% team.members.forEach(member => { %>
              <div class="col-md-6 mb-3">
                <div class="d-flex align-items-center">
                  <img src="<%= member.profile_pic || '/images/default-avatar.png' %>" 
                       alt="<%= member.name %>" 
                       class="rounded-circle me-3" 
                       style="width: 50px; height: 50px; object-fit: cover;">
                  <div>
                    <h6 class="mb-0"><%= member.name %></h6>
                    <p class="text-muted mb-0 small">
                      <%= member.role %>
                      <% if (member.user_id === team.leader_id) { %>
                        <span class="badge bg-warning text-dark ms-1">Leader</span>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <!-- Team Stats Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">Team Stats</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span>Members:</span>
            <span class="fw-bold"><%= team.members.length %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Created:</span>
            <span class="fw-bold"><%= new Date(team.created_at).toLocaleDateString() %></span>
          </div>
          <% if (team.max_members) { %>
            <div class="d-flex justify-content-between mb-2">
              <span>Max Members:</span>
              <span class="fw-bold"><%= team.max_members %></span>
            </div>
          <% } %>
          <div class="d-flex justify-content-between">
            <span>Status:</span>
            <span class="fw-bold"><%= team.status || 'Active' %></span>
          </div>
        </div>
      </div>
      
      <!-- Team Leader Card -->
      <% if (team.leader_id && team.leader_name) { %>
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-white">
            <h5 class="mb-0">Team Leader</h5>
          </div>
          <div class="card-body">
            <div class="d-flex align-items-center">
              <% const leader = team.members.find(m => m.user_id === team.leader_id); %>
              <img src="<%= leader?.profile_pic || '/images/default-avatar.png' %>" 
                   alt="<%= team.leader_name %>" 
                   class="rounded-circle me-3" 
                   style="width: 60px; height: 60px; object-fit: cover;">
              <div>
                <h5 class="mb-1"><%= team.leader_name %></h5>
                <a href="/users/<%= team.leader_id %>" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-person me-1"></i>View Profile
                </a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Join Team Modal -->
<div class="modal fade" id="joinTeamModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Join Team</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to join this team?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmJoinBtn">Join Team</button>
      </div>
    </div>
  </div>
</div>

<!-- Leave Team Modal -->
<div class="modal fade" id="leaveTeamModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Leave Team</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to leave this team?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmLeaveBtn">Leave Team</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Team Modal -->
<div class="modal fade" id="deleteTeamModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Team</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete this team? This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Team</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Join team functionality
    const joinTeamBtn = document.querySelector('.join-team-btn');
    const confirmJoinBtn = document.getElementById('confirmJoinBtn');
    const joinTeamModal = new bootstrap.Modal(document.getElementById('joinTeamModal'));
    
    if (joinTeamBtn) {
      joinTeamBtn.addEventListener('click', function() {
        joinTeamModal.show();
      });
      
      confirmJoinBtn.addEventListener('click', function() {
        const teamId = joinTeamBtn.dataset.teamId;
        
        fetch(`/teams/${teamId}/join`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          joinTeamModal.hide();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Failed to join team');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while trying to join the team');
        });
      });
    }
    
    // Leave team functionality
    const leaveTeamBtn = document.querySelector('.leave-team-btn');
    const confirmLeaveBtn = document.getElementById('confirmLeaveBtn');
    const leaveTeamModal = new bootstrap.Modal(document.getElementById('leaveTeamModal'));
    
    if (leaveTeamBtn) {
      leaveTeamBtn.addEventListener('click', function() {
        leaveTeamModal.show();
      });
      
      confirmLeaveBtn.addEventListener('click', function() {
        const teamId = leaveTeamBtn.dataset.teamId;
        
        fetch(`/teams/${teamId}/leave`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          leaveTeamModal.hide();
          if (data.success) {
            window.location.href = '/teams';
          } else {
            alert(data.message || 'Failed to leave team');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while trying to leave the team');
        });
      });
    }
    
    // Delete team functionality
    const deleteTeamBtn = document.querySelector('.delete-team-btn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const deleteTeamModal = new bootstrap.Modal(document.getElementById('deleteTeamModal'));
    
    if (deleteTeamBtn) {
      deleteTeamBtn.addEventListener('click', function() {
        deleteTeamModal.show();
      });
      
      confirmDeleteBtn.addEventListener('click', function() {
        const teamId = deleteTeamBtn.dataset.teamId;
        
        fetch(`/teams/${teamId}/delete`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          deleteTeamModal.hide();
          if (data.success) {
            window.location.href = '/teams';
          } else {
            alert(data.message || 'Failed to delete team');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while trying to delete the team');
        });
      });
    }
  });
</script>

<%- include('partials/footer') %>