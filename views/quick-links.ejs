<!-- quick-links.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | InspiraGrid</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/quick-links.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/dashboard">
                <img src="/images/logo.png" alt="Inspira Grid" class="logo-img me-2" width="40" height="40">
                <span class="logo-text">Inspira Grid</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">
                            <i class="fas fa-home me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/projects">
                            <i class="fas fa-project-diagram me-2"></i>Projects
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/teams">
                            <i class="fas fa-users me-2"></i>Teams
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/messages">
                            <i class="fas fa-envelope me-2"></i>Messages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/quick-links">
                            <i class="fas fa-link me-2"></i>Quick Links
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown">
                            <img src="<%= user.profile_pic || '/images/default-avatar.png' %>" class="rounded-circle me-2" width="32" height="32">
                            <span class="text-white"><%= user.name %></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="/settings"><i class="fas fa-cog me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-link"></i> Quick Links</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="/resources" class="list-group-item list-group-item-action <%= activePage === 'resources' ? 'active' : '' %>">
                            <i class="fas fa-book me-2"></i> Resources
                        </a>
                        <a href="/calendar" class="list-group-item list-group-item-action <%= activePage === 'calendar' ? 'active' : '' %>">
                            <i class="fas fa-calendar-alt me-2"></i> Calendar
                        </a>
                        <a href="/reports" class="list-group-item list-group-item-action <%= activePage === 'reports' ? 'active' : '' %>">
                            <i class="fas fa-chart-bar me-2"></i> Reports
                        </a>
                        <a href="/help" class="list-group-item list-group-item-action <%= activePage === 'help' ? 'active' : '' %>">
                            <i class="fas fa-question-circle me-2"></i> Help Center
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="<%= pageIcon %>"></i> <%= pageTitle %></h4>
                    </div>
                    <div class="card-body">
                        <% if (typeof content !== 'undefined') { %>
                            <div class="row">
                                <% content.forEach(item => { %>
                                    <div class="col-md-<%= item.colSize || 6 %> mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="<%= item.icon %>"></i> <%= item.title %></h5>
                                            </div>
                                            <div class="card-body">
                                                <%= item.description %>
                                                <% if (item.link) { %>
                                                    <div class="mt-3">
                                                        <a href="<%= item.link %>" class="btn btn-primary btn-sm">
                                                            <i class="<%= item.linkIcon || 'fas fa-arrow-right' %>"></i> <%= item.linkText || 'View More' %>
                                                        </a>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <!-- Resources Page Content -->
                            <% if (activePage === 'resources') { %>
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-book"></i> Documentation</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Access our comprehensive documentation for guides, tutorials, and reference materials.</p>
                                                <a href="/resources/documentation" class="btn btn-primary btn-sm">View Documentation</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-video"></i> Video Tutorials</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Watch step-by-step tutorial videos to learn how to use all features effectively.</p>
                                                <a href="/resources/videos" class="btn btn-primary btn-sm">Watch Tutorials</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-file-download"></i> Templates</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Download ready-to-use templates for projects, reports, and presentations.</p>
                                                <a href="/resources/templates" class="btn btn-primary btn-sm">Get Templates</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-tools"></i> Tools</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Access additional tools and utilities to enhance your productivity.</p>
                                                <a href="/resources/tools" class="btn btn-primary btn-sm">Explore Tools</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Calendar Page Content -->
                            <% if (activePage === 'calendar') { %>
                                <div class="alert alert-info mb-4">
                                    <i class="fas fa-info-circle"></i> Select dates to view or add events. Sync with your team's schedule for better coordination.
                                </div>
                                <div class="calendar-container">
                                    <div class="calendar-header d-flex justify-content-between align-items-center mb-3">
                                        <button class="btn btn-outline-primary btn-sm" id="prevMonth"><i class="fas fa-chevron-left"></i></button>
                                        <h5 class="mb-0" id="currentMonth">March 2025</h5>
                                        <button class="btn btn-outline-primary btn-sm" id="nextMonth"><i class="fas fa-chevron-right"></i></button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-bordered calendar-table">
                                            <thead>
                                                <tr>
                                                    <th>Sun</th>
                                                    <th>Mon</th>
                                                    <th>Tue</th>
                                                    <th>Wed</th>
                                                    <th>Thu</th>
                                                    <th>Fri</th>
                                                    <th>Sat</th>
                                                </tr>
                                            </thead>
                                            <tbody id="calendarBody">
                                                <!-- Calendar days will be generated by JavaScript -->
                                                <tr>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td>1</td>
                                                </tr>
                                                <tr>
                                                    <td>2</td>
                                                    <td>3</td>
                                                    <td>4</td>
                                                    <td>5</td>
                                                    <td>6</td>
                                                    <td>7</td>
                                                    <td>8</td>
                                                </tr>
                                                <tr>
                                                    <td>9</td>
                                                    <td>10</td>
                                                    <td>11</td>
                                                    <td>12</td>
                                                    <td>13</td>
                                                    <td>14</td>
                                                    <td>15</td>
                                                </tr>
                                                <tr>
                                                    <td>16</td>
                                                    <td>17</td>
                                                    <td>18</td>
                                                    <td>19</td>
                                                    <td>20</td>
                                                    <td class="bg-primary text-white">21</td>
                                                    <td>22</td>
                                                </tr>
                                                <tr>
                                                    <td>23</td>
                                                    <td>24</td>
                                                    <td>25</td>
                                                    <td>26</td>
                                                    <td>27</td>
                                                    <td>28</td>
                                                    <td>29</td>
                                                </tr>
                                                <tr>
                                                    <td>30</td>
                                                    <td>31</td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="my-4">
                                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEventModal">
                                            <i class="fas fa-plus"></i> Add Event
                                        </button>
                                    </div>
                                    <div class="upcoming-events mt-4">
                                        <h5><i class="fas fa-calendar-check"></i> Upcoming Events</h5>
                                        <div class="list-group">
                                            <div class="list-group-item list-group-item-action">
                                                <div class="d-flex w-100 justify-content-between">
                                                    <h6 class="mb-1">Project Deadline: UI Redesign</h6>
                                                    <small>March 25, 2025</small>
                                                </div>
                                                <p class="mb-1">Final submission of UI redesign project</p>
                                                <small class="text-muted"><i class="fas fa-user"></i> Assigned to your team</small>
                                            </div>
                                            <div class="list-group-item list-group-item-action">
                                                <div class="d-flex w-100 justify-content-between">
                                                    <h6 class="mb-1">Team Meeting</h6>
                                                    <small>March 23, 2025</small>
                                                </div>
                                                <p class="mb-1">Weekly progress review meeting</p>
                                                <small class="text-muted"><i class="fas fa-clock"></i> 10:00 AM - 11:00 AM</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Reports Page Content -->
                            <% if (activePage === 'reports') { %>
                                <div class="alert alert-primary mb-4">
                                    <i class="fas fa-chart-line"></i> View performance metrics and analytics across your projects and teams.
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-project-diagram"></i> Project Reports</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Access detailed reports about your project performance, timelines, and resource allocation.</p>
                                                <a href="/reports/projects" class="btn btn-primary btn-sm">View Project Reports</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-users"></i> Team Reports</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Review team performance metrics, member contributions, and collaboration analytics.</p>
                                                <a href="/reports/teams" class="btn btn-primary btn-sm">View Team Reports</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-user"></i> Individual Reports</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Check your personal performance metrics, activity logs, and productivity analytics.</p>
                                                <a href="/reports/individual" class="btn btn-primary btn-sm">View My Reports</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-file-export"></i> Export Data</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Export reports and data in various formats for offline analysis or presentations.</p>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                                        Export As
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li><a class="dropdown-item" href="#"><i class="far fa-file-pdf"></i> PDF</a></li>
                                                        <li><a class="dropdown-item" href="#"><i class="far fa-file-excel"></i> Excel</a></li>
                                                        <li><a class="dropdown-item" href="#"><i class="far fa-file-csv"></i> CSV</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Help Center Content -->
                            <% if (activePage === 'help') { %>
                                <div class="alert alert-info mb-4">
                                    <i class="fas fa-info-circle"></i> Need help? Find answers to common questions or contact support.
                                </div>
                                <div class="mb-4">
                                    <form class="d-flex">
                                        <input class="form-control me-2" type="search" placeholder="Search help articles..." aria-label="Search">
                                        <button class="btn btn-outline-primary" type="submit"><i class="fas fa-search"></i></button>
                                    </form>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-question-circle"></i> FAQs</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Find answers to frequently asked questions about using InspiraGrid.</p>
                                                <a href="/help/faq" class="btn btn-primary btn-sm">View FAQs</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-book-open"></i> Knowledge Base</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Browse our comprehensive knowledge base for detailed guides and solutions.</p>
                                                <a href="/help/knowledge-base" class="btn btn-primary btn-sm">Explore Knowledge Base</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-ticket-alt"></i> Support Tickets</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Create and manage support tickets for issues that require assistance.</p>
                                                <a href="/help/tickets" class="btn btn-primary btn-sm">View My Tickets</a>
                                                <a href="/help/tickets/new" class="btn btn-outline-primary btn-sm ms-2">New Ticket</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5><i class="fas fa-comments"></i> Live Chat Support</h5>
                                            </div>
                                            <div class="card-body">
                                                <p>Chat with our support team in real-time for immediate assistance.</p>
                                                <button class="btn btn-primary btn-sm">Start Chat</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Add Event (Calendar) -->
    <div class="modal fade" id="addEventModal" tabindex="-1" aria-labelledby="addEventModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addEventModalLabel">Add New Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addEventForm">
                        <div class="mb-3">
                            <label for="eventTitle" class="form-label">Event Title</label>
                            <input type="text" class="form-control" id="eventTitle" required>
                        </div>
                        <div class="mb-3">
                            <label for="eventDate" class="form-label">Date</label>
                            <input type="date" class="form-control" id="eventDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="eventTime" class="form-label">Time</label>
                            <input type="time" class="form-control" id="eventTime">
                        </div>
                        <div class="mb-3">
                            <label for="eventDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="eventDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="eventCategory" class="form-label">Category</label>
                            <select class="form-select" id="eventCategory">
                                <option value="meeting">Meeting</option>
                                <option value="deadline">Deadline</option>
                                <option value="reminder">Reminder</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="notifyTeam">
                            <label class="form-check-label" for="notifyTeam">Notify Team Members</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary">Save Event</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; 2025 InspiraGrid. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="/privacy" class="text-decoration-none me-3">Privacy Policy</a>
                    <a href="/terms" class="text-decoration-none me-3">Terms of Service</a>
                    <a href="/contact" class="text-decoration-none">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/scripts.js"></script>
    <% if (activePage === 'calendar') { %>
    <script>
        // Simple calendar functionality
        document.addEventListener('DOMContentLoaded', function() {
            // This would be expanded in a real implementation
            console.log('Calendar page loaded');
            
            // Current date for demonstration
            const currentDate = new Date();
            
            // Event handlers for navigation
            document.getElementById('prevMonth').addEventListener('click', function() {
                console.log('Previous month clicked');
            });
            
            document.getElementById('nextMonth').addEventListener('click', function() {
                console.log('Next month clicked');
            });
        });
    </script>
    <% } %>
</body>
</html>