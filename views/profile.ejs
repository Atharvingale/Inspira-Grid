<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inspira Grid Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
    <%- include('./partials/header', { 
        title: 'Dashboard', 
        currentPage: 'dashboard',
        cssFiles: ['dashboard']
    }) %>
    <div class="container py-4">
        <div class="row">
            <div class="col-lg-4 mb-4">
                <!-- Profile Card -->
                <div class="card profile-card">
                    <div class="profile-header"></div>
                    <!-- Update the profile avatar image src -->
                    <div class="profile-avatar">
                        <img src="/profile-pic/<%= user.user_id %>" class="rounded-circle" width="120" height="120">
                        <!-- Update the avatar edit button to trigger the modal -->
                        <button class="btn btn-sm btn-light rounded-circle avatar-edit-btn" 
                                title="Change Profile Picture" 
                                data-bs-toggle="modal" 
                                data-bs-target="#photoModal">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                    <div class="card-body text-center">
                        <h4 class="mb-1"><%= user.name %></h4>
                        <p class="text-muted mb-3"><%= user.title %></p>
                        
                        <div class="profile-stats mb-4">
                            <div class="row g-0">
                                <div class="col-4">
                                    <div class="p-3">
                                        <h5 class="mb-0"><%= user.projectCount %></h5>
                                        <small class="text-muted">Projects</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-3">
                                        <h5 class="mb-0"><%= user.teamCount %></h5>
                                        <small class="text-muted">Teams</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-3">
                                        <h5 class="mb-0"><%= user.taskCount %></h5>
                                        <small class="text-muted">Tasks</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Keep only this Edit Profile button -->
                        <button class="btn action-btn action-btn-outline w-100" onclick="window.location.href='/profile/edit'">
                            <i class="fas fa-edit me-2"></i> Edit Profile
                        </button>
                    </div>
                </div>
                
                <!-- Contact Information -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-address-card me-2"></i> Contact Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div>
                                <small class="text-muted">Email</small>
                                <p class="mb-0"><%= user.email %></p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div>
                                <small class="text-muted">Phone</small>
                                <p class="mb-0"><%= user.phone || 'Not provided' %></p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div>
                                <small class="text-muted">Location</small>
                                <p class="mb-0"><%= user.location || 'Not provided' %></p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Skills -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-tools me-2"></i> Skills</h5>
                    </div>
                    <div class="card-body">
                        <% if (user.skills && Array.isArray(user.skills)) { %>
                            <% user.skills.forEach(function(skill) { %>
                                <div class="skill-item">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span><%= skill.name %></span>
                                        <span><%= skill.level %>%</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: <%= skill.level %>%;" 
                                            aria-valuenow="<%= skill.level %>" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-muted">No skills added yet.</p>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8">
                <!-- About Me -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-user me-2"></i> About Me</h5>
                    </div>
                    <div class="card-body">
                        <p><%= user.bio || 'No bio provided yet.' %></p>
                    </div>
                </div>
                
                <!-- Work Experience -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-briefcase me-2"></i> Work Experience</h5>
                        <button class="btn btn-sm btn-link">
                            <i class="fas fa-plus me-1"></i> Add
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (user.experience && user.experience.length > 0) { %>
                            <% user.experience.forEach(function(exp) { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <div class="d-flex justify-content-between">
                                        <h5><%= exp.position %></h5>
                                        <div class="timeline-date">
                                            <%= exp.startDate %> - <%= exp.endDate || 'Present' %>
                                        </div>
                                    </div>
                                    <h6 class="text-primary"><%= exp.company %></h6>
                                    <p><%= exp.description %></p>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-muted">No work experience added yet.</p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Education -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-graduation-cap me-2"></i> Education</h5>
                        <button class="btn btn-sm btn-link">
                            <i class="fas fa-plus me-1"></i> Add
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (user.education && user.education.length > 0) { %>
                            <% user.education.forEach(function(edu) { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <div class="d-flex justify-content-between">
                                        <h5><%= edu.degree %></h5>
                                        <div class="timeline-date">
                                            <%= edu.startYear %> - <%= edu.endYear || 'Present' %>
                                        </div>
                                    </div>
                                    <h6 class="text-primary"><%= edu.institution %></h6>
                                    <p><%= edu.description %></p>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-muted">No education details added yet.</p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Recent Activity -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-history me-2"></i> Recent Activity</h5>
                        <a href="/activity" class="btn btn-sm btn-link">
                            <i class="fas fa-arrow-right me-1"></i> View All
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <% if (user && user.recentActivities) { %>
                                <% user.recentActivities.forEach(function(activity) { %>
                                    <li class="list-group-item">
                                        <div class="d-flex align-items-center">
                                            <div class="activity-icon me-3">
                                                <i class="<%= activity.icon %>"></i>
                                            </div>
                                            <div>
                                                <p class="mb-0 fw-medium"><%= activity.description %></p>
                                                <small class="text-muted"><i class="far fa-clock me-1"></i> <%= activity.time_ago %></small>
                                            </div>
                                        </div>
                                    </li>
                                <% }); %>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add this before the footer -->
    <!-- Profile Photo Upload Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="/profile/upload-photo" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="photo" class="form-label">Choose Photo</label>
                            <input type="file" class="form-control" id="photo" name="photo" accept="image/*" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Upload Photo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-light py-3 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-muted">© 2025 Inspira Grid. All rights reserved.</p>
        </div>
    </footer>

    <!-- Keep only the profile.js file since other scripts are in header -->
    <script src="/js/profile.js"></script>
</body>
</html>