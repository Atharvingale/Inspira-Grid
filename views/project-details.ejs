<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= project.title %> | Inspira Grid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/project-details.css">
</head>
<body>
    <!-- Include Navbar Partial -->
    <%- include('./partials/header', { 
        title: 'Projects', 
        currentPage: 'projects',
        cssFiles: ['dashboard']
    }) %>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="project-header">
                <h1 id="project-title"><%= project.title %></h1>
                <div class="project-meta">
                    <div class="owner-info">
                        <img src="<%= project.owner_pic || '/images/user.jpg' %>" alt="<%= project.owner_name %>" class="owner-avatar">
                        <span class="owner-name"><%= project.owner_name %></span>
                        <span class="owner-badge">Owner</span>
                    </div>
                    <div class="project-status">
                        <span class="status-badge <%= project.status.toLowerCase().replace(' ', '-') %>"><%= project.status %></span>
                    </div>
                </div>
                <div class="project-dates">
                    <span>Created: <%= project.formatted_created_at %></span>
                    <span>Last Updated: <%= project.formatted_updated_at %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container">
            <% if (error) { %>
                <div class="alert alert-danger mt-3" role="alert">
                    <%= error %>
                </div>
            <% } %>
            
            <% if (success) { %>
                <div class="alert alert-success mt-3" role="alert">
                    <%= success %>
                </div>
            <% } %>
            
            <div class="content-wrapper">
                <!-- Left Side (Main Content) -->
                <div class="main-column">
                    <!-- Project Description -->
                    <section class="project-description card">
                        <h2>Project Description</h2>
                        <p><%= project.description %></p>
                        
                        <h3>Required Skills</h3>
                        <div class="skills-tags">
                            <% project.required_skills.forEach(skill => { %>
                                <span class="skill-tag"><%= skill %></span>
                            <% }); %>
                        </div>
                        
                        <div class="project-category">
                            <h3>Category</h3>
                            <span><%= project.category %></span>
                        </div>
                    </section>

                    <!-- Contributions & Updates -->
                    <section class="project-updates card">
                        <h2>Project Updates</h2>
                        <div class="timeline">
                            <% if (typeof updates !== 'undefined' && updates && updates.length > 0) { %>
                                <% updates.forEach(update => { %>
                                    <div class="timeline-item">
                                        <div class="timeline-date"><%= update.formatted_date %></div>
                                        <div class="timeline-content">
                                            <h4><%= update.title %></h4>
                                            <p><%= update.content %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p>No updates yet.</p>
                            <% } %>
                        </div>
                        
                        <% if (isMember) { %>
                            <div class="mt-4">
                                <h3>Add Project Update</h3>
                                <form action="/projects/<%= project.project_id %>/update-timeline" method="POST">
                                    <div class="mb-3">
                                        <input type="text" class="form-control" name="title" placeholder="Update Title" required>
                                    </div>
                                    <div class="mb-3">
                                        <textarea class="form-control" name="content" rows="3" placeholder="Update Content" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Add Update</button>
                                </form>
                            </div>
                        <% } %>
                    </section>

                    <!-- Discussions & Comments -->
                    <section class="project-discussions card" id="comments">
                        <h2>Discussions</h2>
                        <div class="comments-section">
                            <% if (comments && comments.length > 0) { %>
                                <% comments.forEach(comment => { %>
                                    <div class="comment">
                                        <img src="<%= comment.profile_pic || '/images/user.jpg' %>" alt="<%= comment.author_name %>" class="comment-avatar">
                                        <div class="comment-content">
                                            <div class="comment-header">
                                                <span class="comment-author"><%= comment.author_name %></span>
                                                <span class="comment-date"><%= comment.formatted_date %></span>
                                            </div>
                                            <p class="comment-text"><%= comment.content %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p>No comments yet. Be the first to comment!</p>
                            <% } %>
                        </div>
                        
                        <!-- Comment Form -->
                        <div class="comment-form">
                            <h3>Add a Comment</h3>
                            <form action="/projects/<%= project.project_id %>/comment" method="POST">
                                <textarea name="comment" placeholder="Write your comment here..." required></textarea>
                                <button type="submit" class="btn btn-primary">Post Comment</button>
                            </form>
                        </div>
                    </section>
                </div>

                <!-- Right Side (Sidebar) -->
                <div class="sidebar">
                    <!-- Team Members -->
                    <section class="team-members card">
                        <h2>Team Members</h2>
                        <ul class="team-list">
                            <% if (team && team.length > 0) { %>
                                <% team.forEach(member => { %>
                                    <li class="team-member">
                                        <img src="<%= member.profile_pic || '/images/user.jpg' %>" alt="<%= member.name %>" class="member-avatar">
                                        <div class="member-info">
                                            <span class="member-name"><%= member.name %></span>
                                            <span class="member-role"><%= member.role %></span>
                                        </div>
                                    </li>
                                <% }); %>
                            <% } else { %>
                                <li>No team members yet.</li>
                            <% } %>
                        </ul>
                        <% if (team && team.length > 5) { %>
                            <a href="/projects/<%= project.project_id %>/team" class="btn btn-secondary">View Full Team</a>
                        <% } %>
                    </section>

                    <!-- Join Project -->
                    <section class="join-project card">
                        <h2>Join This Project</h2>
                        <% if (isMember) { %>
                            <div class="already-member">You are part of this project</div>
                        <% } else if (hasPendingApplication) { %>
                            <div class="application-pending">Application Pending</div>
                        <% } else if (project.status === 'Open') { %>
                            <p>This project is currently open for new team members.</p>
                            <button type="button" class="btn btn-primary btn-large" data-bs-toggle="modal" data-bs-target="#applyProjectModal">
                                <i class="fas fa-paper-plane me-2"></i>Apply Now
                            </button>
                        <% } else { %>
                            <p>This project is not currently accepting new members.</p>
                        <% } %>
                    </section>

                    <!-- Application Modal -->
                    <div class="modal fade" id="applyProjectModal" tabindex="-1" aria-labelledby="applyProjectModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header bg-gradient-primary text-white">
                                    <h5 class="modal-title" id="applyProjectModalLabel">
                                        <i class="fas fa-paper-plane me-2"></i>Apply to Project
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <!-- Project Info Summary -->
                                    <div class="project-summary mb-4 p-3 rounded bg-light">
                                        <h6 class="project-title mb-2 d-flex align-items-center">
                                            <i class="fas fa-project-diagram text-primary me-2"></i>
                                            <span id="modalProjectTitle"><%= project.title %></span>
                                        </h6>
                                    </div>
                                    
                                    <!-- Application Steps Progress -->
                                    <div class="application-progress mb-4">
                                        <div class="steps-indicator d-flex justify-content-between mb-2">
                                            <span class="step-indicator active" id="step1Indicator">1. Basic Info</span>
                                            <span class="step-indicator" id="step2Indicator">2. Skills & Experience</span>
                                            <span class="step-indicator" id="step3Indicator">3. Review</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                    
                                    <form id="projectApplicationForm" class="needs-validation" novalidate>
                                        <input type="hidden" id="projectIdInput" name="project_id" value="<%= project.project_id %>">
                                        
                                        <!-- Step 1: Basic Info (visible by default) -->
                                        <div class="form-step" id="step1">
                                            <div class="mb-4">
                                                <label for="coverLetter" class="form-label fw-bold">
                                                    <i class="fas fa-comment-alt text-primary me-2"></i>Why are you interested in this project?
                                                </label>
                                                <textarea class="form-control" id="coverLetter" name="cover_letter" rows="4" placeholder="Describe your interest and how your skills match the project requirements..." required></textarea>
                                                <div class="form-text">Be specific about your relevant experience and what excites you about this project.</div>
                                                <div class="invalid-feedback">Please provide a cover letter.</div>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <label for="availability" class="form-label fw-bold">
                                                    <i class="fas fa-calendar-alt text-primary me-2"></i>Availability
                                                </label>
                                                <select class="form-select" id="availability" name="availability" required>
                                                    <option value="" selected disabled>Select your availability</option>
                                                    <option value="Full-time">Full-time</option>
                                                    <option value="Part-time">Part-time</option>
                                                    <option value="Weekends">Weekends only</option>
                                                    <option value="Evenings">Evenings only</option>
                                                    <option value="Flexible">Flexible</option>
                                                </select>
                                                <div class="form-text">Let the project owner know when you're available to contribute.</div>
                                                <div class="invalid-feedback">Please select your availability.</div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-end">
                                                <button type="button" class="btn btn-primary px-4" id="nextToStep2Btn">
                                                    Next <i class="fas fa-arrow-right ms-2"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- Step 2: Skills & Experience (hidden by default) -->
                                        <div class="form-step d-none" id="step2">
                                            <div class="mb-4">
                                                <label for="relevantSkills" class="form-label fw-bold">
                                                    <i class="fas fa-code text-primary me-2"></i>Relevant Skills
                                                </label>
                                                <div class="skills-selection-container">
                                                    <!-- Search and add custom skill -->
                                                    <div class="input-group mb-3">
                                                        <span class="input-group-text bg-white border-end-0">
                                                            <i class="fas fa-search text-muted"></i>
                                                        </span>
                                                        <input type="text" class="form-control border-start-0" id="skillsSearchInput" placeholder="Search or add new skill...">
                                                        <button class="btn btn-primary" type="button" id="addCustomSkillBtn">
                                                            <i class="fas fa-plus"></i> Add
                                                        </button>
                                                    </div>
                                                    
                                                    <!-- Skills categories tabs -->
                                                    <ul class="nav nav-pills nav-fill skills-categories mb-3" id="skillsCategoriesTabs" role="tablist">
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link active" id="all-skills-tab" data-bs-toggle="pill" data-bs-target="#all-skills" type="button" role="tab">All</button>
                                                        </li>
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link" id="frontend-skills-tab" data-bs-toggle="pill" data-bs-target="#frontend-skills" type="button" role="tab">Frontend</button>
                                                        </li>
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link" id="backend-skills-tab" data-bs-toggle="pill" data-bs-target="#backend-skills" type="button" role="tab">Backend</button>
                                                        </li>
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link" id="data-skills-tab" data-bs-toggle="pill" data-bs-target="#data-skills" type="button" role="tab">Data</button>
                                                        </li>
                                                        <li class="nav-item" role="presentation">
                                                            <button class="nav-link" id="custom-skills-tab" data-bs-toggle="pill" data-bs-target="#custom-skills" type="button" role="tab">Custom</button>
                                                        </li>
                                                    </ul>
                                                    
                                                    <!-- Skills content -->
                                                    <div class="tab-content p-3 border rounded skills-selection-area" id="skillsTabContent">
                                                        <!-- All skills tab -->
                                                        <div class="tab-pane fade show active" id="all-skills" role="tabpanel">
                                                            <div class="skills-grid">
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="JavaScript" id="skill-javascript">
                                                                    <label class="form-check-label" for="skill-javascript">JavaScript</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Python" id="skill-python">
                                                                    <label class="form-check-label" for="skill-python">Python</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Java" id="skill-java">
                                                                    <label class="form-check-label" for="skill-java">Java</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="React" id="skill-react">
                                                                    <label class="form-check-label" for="skill-react">React</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Node.js" id="skill-nodejs">
                                                                    <label class="form-check-label" for="skill-nodejs">Node.js</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="UI/UX Design" id="skill-uiux">
                                                                    <label class="form-check-label" for="skill-uiux">UI/UX Design</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Machine Learning" id="skill-ml">
                                                                    <label class="form-check-label" for="skill-ml">Machine Learning</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Data Science" id="skill-datascience">
                                                                    <label class="form-check-label" for="skill-datascience">Data Science</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="Mobile Development" id="skill-mobile">
                                                                    <label class="form-check-label" for="skill-mobile">Mobile Development</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="DevOps" id="skill-devops">
                                                                    <label class="form-check-label" for="skill-devops">DevOps</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- Frontend skills tab -->
                                                        <div class="tab-pane fade" id="frontend-skills" role="tabpanel">
                                                            <div class="skills-grid">
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="JavaScript" id="skill-javascript-fe">
                                                                    <label class="form-check-label" for="skill-javascript-fe">JavaScript</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="React" id="skill-react-fe">
                                                                    <label class="form-check-label" for="skill-react-fe">React</label>
                                                                </div>
                                                                <div class="form-check skill-item">
                                                                    <input class="form-check-input" type="checkbox" name="relevant_skills[]" value="UI/UX Design" id="skill-uiux-fe">
                                                                    <label class="form-check-label" for="skill-uiux-fe">UI/UX Design</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- Custom skills tab -->
                                                        <div class="tab-pane fade" id="custom-skills" role="tabpanel">
                                                            <div id="customSkillsContainer" class="skills-grid">
                                                                <!-- Custom skills will be added here dynamically -->
                                                                <div class="empty-custom-skills text-center text-muted py-3">
                                                                    <i class="fas fa-plus-circle fs-4 mb-2"></i>
                                                                    <p>Add custom skills using the input field above</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- Add other category tabs with similar structure -->
                                                    </div>
                                                    
                                                    <!-- Selected skills display -->
                                                    <div class="selected-skills mt-2" id="selectedSkillsContainer">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <small class="text-muted me-2">Selected skills:</small>
                                                            <div id="selectedSkillsBadges" class="d-flex flex-wrap"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-text">Select skills that are relevant to this specific project or add custom ones.</div>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <label for="experience" class="form-label fw-bold">
                                                    <i class="fas fa-briefcase text-primary me-2"></i>Relevant Experience
                                                </label>
                                                <textarea class="form-control" id="experience" name="experience" rows="3" placeholder="Briefly describe your relevant experience..."></textarea>
                                                <div class="form-text">Highlight specific experiences that make you a good fit for this project.</div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" id="backToStep1Btn">
                                                    <i class="fas fa-arrow-left me-2"></i> Back
                                                </button>
                                                <button type="button" class="btn btn-primary px-4" id="nextToStep3Btn">
                                                    Next <i class="fas fa-arrow-right ms-2"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- Step 3: Review (hidden by default) -->
                                        <div class="form-step d-none" id="step3">
                                            <div class="application-review p-3 bg-light rounded mb-4">
                                                <h6 class="mb-3">Review Your Application</h6>
                                                <div class="review-item mb-3">
                                                    <strong>Interest:</strong>
                                                    <p id="reviewCoverLetter" class="mb-2 text-muted">Your cover letter will appear here</p>
                                                </div>
                                                <div class="review-item mb-3">
                                                    <strong>Availability:</strong>
                                                    <p id="reviewAvailability" class="mb-2 text-muted">Your availability will appear here</p>
                                                </div>
                                                <div class="review-item mb-3">
                                                    <strong>Skills:</strong>
                                                    <div id="reviewSkills" class="mb-2"></div>
                                                </div>
                                                <div class="review-item">
                                                    <strong>Experience:</strong>
                                                    <p id="reviewExperience" class="mb-0 text-muted">Your experience will appear here</p>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between">
                                                <button type="button" class="btn btn-outline-secondary" id="backToStep2Btn">
                                                    <i class="fas fa-arrow-left me-2"></i> Back
                                                </button>
                                                <button type="button" class="btn btn-primary px-4" id="submitApplicationBtn">
                                                    <i class="fas fa-paper-plane me-2"></i>Submit Application
                                                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Project Actions (for owners) -->
                    <% if (project.owner_id === user.user_id) { %>
                        <section class="project-actions card">
                            <h2>Project Actions</h2>
                            <div class="action-buttons">
                                <a href="/projects/<%= project.project_id %>/edit" class="btn btn-edit"><i class="fas fa-edit"></i> Edit Project</a>
                                <button class="btn btn-danger" onclick="confirmDelete()"><i class="fas fa-trash"></i> Delete Project</button>
                                <button class="btn btn-share" data-bs-toggle="modal" data-bs-target="#shareProjectModal"><i class="fas fa-share-alt"></i> Share Project</button>
                            </div>
                        </section>
                        
                        <!-- Project Applications (for owners) -->
                        <section class="project-applications card">
                            <h2>Applications</h2>
                            <% if (applications && applications.length > 0) { %>
                                <ul class="applications-list">
                                    <% applications.forEach(application => { %>
                                        <li class="application-item">
                                            <div class="applicant-info">
                                                <img src="<%= application.profile_pic || '/images/user.jpg' %>" alt="<%= application.user_name %>" class="applicant-avatar">
                                                <div class="applicant-details">
                                                    <span class="applicant-name"><%= application.user_name %></span>
                                                    <span class="application-date"><%= application.formatted_date %></span>
                                                </div>
                                            </div>
                                            <div class="application-actions">
                                                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#viewApplicationModal" 
                                                    data-application-id="<%= application.application_id %>"
                                                    data-user-id="<%= application.user_id %>"
                                                    data-user-name="<%= application.user_name %>"
                                                    data-cover-letter="<%= application.cover_letter %>"
                                                    data-skills="<%= JSON.stringify(application.relevant_skills) %>"
                                                    data-availability="<%= application.availability %>"
                                                    data-experience="<%= application.experience || '' %>"
                                                    data-profile-pic="<%= application.profile_pic || '/images/user.jpg' %>"
                                                    data-status="<%= application.status %>">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </div>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p>No applications received yet.</p>
                            <% } %>
                        </section>
                    <% } %>

                    <!-- Add this near the end of the body tag, before the closing </body> -->
                    <script>
                        function confirmDelete() {
                            if (confirm('Are you sure you want to delete this project? This action cannot be undone.')) {
                                fetch('/projects/<%= project.project_id %>/delete', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    credentials: 'same-origin'
                                })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        window.location.href = '/projects';
                                    } else {
                                        alert('Failed to delete project: ' + (data.message || 'Unknown error'));
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    alert('Failed to delete project. Please try again.');
                                });
                            }
                        }
                    </script>
                    <!-- Project Progress -->
                </div>
                <section class="project-progress card">
                    <h2>Project Progress</h2>
                    <div class="progress-bar">
                        <div class="progress" style="width: <%= progress %>%"><%= progress %>%</div>
                    </div>
                    
                    <div class="milestone-tracker">
                        <% if (project.milestones && project.milestones.length > 0) { %>
                            <% project.milestones.forEach((milestone, index) => { %>
                                <div class="milestone <%= project.milestone_status[index] %>">
                                    <div class="milestone-dot"></div>
                                    <div class="milestone-text"><%= milestone %></div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p>No milestones defined.</p>
                        <% } %>
                    </div>
                </section>
            </div>
            
            <!-- Related Projects -->
            <% if (relatedProjects && relatedProjects.length > 0) { %>
                <section class="related-projects">
                    <h2>Related Projects</h2>
                    <div class="projects-carousel">
                        <% relatedProjects.forEach(relatedProject => { %>
                            <div class="project-card">
                                <h3><a href="/projects/<%= relatedProject.project_id %>"><%= relatedProject.title %></a></h3>
                                <p><%= relatedProject.description.substring(0, 100) %>...</p>
                                <div class="project-card-skills">
                                    <% 
                                    let skills = relatedProject.required_skills;
                                    if (typeof skills === 'string') {
                                        skills = JSON.parse(skills);
                                    }
                                    skills.slice(0, 3).forEach(skill => { 
                                    %>
                                        <span class="skill-tag"><%= skill %></span>
                                    <% }); %>
                                    <% if (skills.length > 3) { %>
                                        <span class="skill-tag">+<%= skills.length - 3 %> more</span>
                                    <% } %>
                                </div>
                                <p>By <%= relatedProject.owner_name %></p>
                            </div>
                        <% }); %>
                    </div>
                </section>
            <% } %>
        </div>
    </div>
    
    <!-- Delete Project Modal -->
    <div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this project? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/projects/<%= project.project_id %>/delete" method="POST">
                        <button type="submit" class="btn btn-danger">Delete Project</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Share Project Modal -->
    <div class="modal fade" id="shareProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Share this project with your network:</p>
                    <div class="share-link-container">
                        <input type="text" class="form-control" id="shareLink" value="<%= `${baseUrl}/projects/${project.project_id}` %>" readonly>
                        <button class="btn btn-primary" id="copyLinkBtn"><i class="fas fa-copy"></i> Copy</button>
                    </div>
                    <div class="social-share-buttons mt-3">
                        <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(projectUrl) %>&text=<%= encodeURIComponent(`Check out this project: ${project.title}`) %>" target="_blank" class="btn btn-twitter">
                            <i class="fab fa-twitter"></i> Twitter
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(projectUrl) %>" target="_blank" class="btn btn-linkedin">
                            <i class="fab fa-linkedin"></i> LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Apply to Project Modal -->
    <div class="modal fade" id="applyProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Apply to Join Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/projects/<%= project.project_id %>/apply" method="POST" id="applicationForm">
                        <div class="mb-3">
                            <label for="applicationMessage" class="form-label">Why do you want to join this project?</label>
                            <textarea class="form-control" id="applicationMessage" name="message" rows="4" placeholder="Describe your interest and how you can contribute..."></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit Application</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- View Application Modal -->
    <div class="modal fade" id="viewApplicationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Application Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <img id="modalApplicantPic" src="/images/user.jpg" alt="Applicant" class="img-fluid rounded-circle mb-2" style="width: 150px; height: 150px; object-fit: cover;">
                            <h5 id="modalApplicantName">Applicant Name</h5>
                            <a id="viewProfileLink" href="#" class="btn btn-sm btn-outline-primary"><i class="fas fa-user"></i> View Full Profile</a>
                        </div>
                        <div class="col-md-8">
                            <div class="application-status mb-3">
                                <span class="fw-bold">Status: </span>
                                <span id="modalApplicationStatus" class="badge bg-warning">Pending</span>
                            </div>
                            <div class="mb-3">
                                <h6 class="fw-bold">Cover Letter</h6>
                                <p id="modalCoverLetter" class="p-2 bg-light rounded">Cover letter content</p>
                            </div>
                            <div class="mb-3">
                                <h6 class="fw-bold">Relevant Skills</h6>
                                <div id="modalSkills" class="skills-container"></div>
                            </div>
                            <div class="mb-3">
                                <h6 class="fw-bold">Availability</h6>
                                <p id="modalAvailability" class="p-2 bg-light rounded">Availability details</p>
                            </div>
                            <div class="mb-3">
                                <h6 class="fw-bold">Experience</h6>
                                <p id="modalExperience" class="p-2 bg-light rounded">Experience details</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="d-flex justify-content-between w-100">
                        <div>
                            <button type="button" class="btn btn-success" id="approveApplicationBtn">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-danger" id="rejectApplicationBtn">
                                <i class="fas fa-times"></i> Reject
                            </button>
                        </div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/projects.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Copy share link functionality
            const copyLinkBtn = document.getElementById('copyLinkBtn');
            if (copyLinkBtn) {
                copyLinkBtn.addEventListener('click', function() {
                    const shareLink = document.getElementById('shareLink');
                    shareLink.select();
                    document.execCommand('copy');
                    
                    // Change button text temporarily
                    const originalText = copyLinkBtn.innerHTML;
                    copyLinkBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(() => {
                        copyLinkBtn.innerHTML = originalText;
                    }, 2000);
                });
            }
            
            // Apply button functionality
            const applyBtn = document.querySelector('.join-project .btn-primary');
            if (applyBtn) {
                applyBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const applyModal = new bootstrap.Modal(document.getElementById('applyProjectModal'));
                    applyModal.show();
                });
            }
            
            // Project action buttons
            const editBtn = document.querySelector('.btn-edit');
            if (editBtn) {
                editBtn.addEventListener('click', function() {
                    window.location.href = '/projects/<%= project.project_id %>/edit';
                });
            }
            
            // Alert auto-dismiss
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.classList.add('fade');
                    setTimeout(() => {
                        alert.remove();
                    }, 500);
                }, 5000);
            });
            
            // Handle form submissions with AJAX (optional enhancement)
            const commentForm = document.querySelector('.comment-form form');
            if (commentForm) {
                commentForm.addEventListener('submit', function(e) {
                    // You can implement AJAX form submission here if desired
                    // This would prevent page reload when posting comments
                    // For now, we'll let the form submit normally
                });
            }
        });
    </script>
    
</body>
</html>