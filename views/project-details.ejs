<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= project.title %> | Inspira Grid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/project-details.css">
</head>
<body>
    <!-- Include Navbar Partial -->
    <%- include('./partials/header', { 
        title: 'Projects', 
        currentPage: 'projects',
        cssFiles: ['dashboard']
    }) %>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="project-header">
                <h1 id="project-title"><%= project.title %></h1>
                <div class="project-meta">
                    <div class="owner-info">
                        <img src="<%= project.owner_pic || '/images/user.jpg' %>" alt="<%= project.owner_name %>" class="owner-avatar">
                        <span class="owner-name"><%= project.owner_name %></span>
                        <span class="owner-badge">Owner</span>
                    </div>
                    <div class="project-status">
                        <span class="status-badge <%= project.status.toLowerCase().replace(' ', '-') %>"><%= project.status %></span>
                    </div>
                </div>
                <div class="project-dates">
                    <span>Created: <%= project.formatted_created_at %></span>
                    <span>Last Updated: <%= project.formatted_updated_at %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container">
            <% if (error) { %>
                <div class="alert alert-danger mt-3" role="alert">
                    <%= error %>
                </div>
            <% } %>
            
            <% if (success) { %>
                <div class="alert alert-success mt-3" role="alert">
                    <%= success %>
                </div>
            <% } %>
            
            <div class="content-wrapper">
                <!-- Left Side (Main Content) -->
                <div class="main-column">
                    <!-- Project Description -->
                    <section class="project-description card">
                        <h2>Project Description</h2>
                        <p><%= project.description %></p>
                        
                        <h3>Required Skills</h3>
                        <div class="skills-tags">
                            <% project.required_skills.forEach(skill => { %>
                                <span class="skill-tag"><%= skill %></span>
                            <% }); %>
                        </div>
                        
                        <div class="project-category">
                            <h3>Category</h3>
                            <span><%= project.category %></span>
                        </div>
                    </section>

                    <!-- Contributions & Updates -->
                    <section class="project-updates card">
                        <h2>Project Updates</h2>
                        <div class="timeline">
                            <% if (typeof updates !== 'undefined' && updates && updates.length > 0) { %>
                                <% updates.forEach(update => { %>
                                    <div class="timeline-item">
                                        <div class="timeline-date"><%= update.formatted_date %></div>
                                        <div class="timeline-content">
                                            <h4><%= update.title %></h4>
                                            <p><%= update.content %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p>No updates yet.</p>
                            <% } %>
                        </div>
                        
                        <% if (isMember) { %>
                            <div class="mt-4">
                                <h3>Add Project Update</h3>
                                <form action="/projects/<%= project.project_id %>/update-timeline" method="POST">
                                    <div class="mb-3">
                                        <input type="text" class="form-control" name="title" placeholder="Update Title" required>
                                    </div>
                                    <div class="mb-3">
                                        <textarea class="form-control" name="content" rows="3" placeholder="Update Content" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Add Update</button>
                                </form>
                            </div>
                        <% } %>
                    </section>

                    <!-- Discussions & Comments -->
                    <section class="project-discussions card" id="comments">
                        <h2>Discussions</h2>
                        <div class="comments-section">
                            <% if (comments && comments.length > 0) { %>
                                <% comments.forEach(comment => { %>
                                    <div class="comment">
                                        <img src="<%= comment.profile_pic || '/images/user.jpg' %>" alt="<%= comment.author_name %>" class="comment-avatar">
                                        <div class="comment-content">
                                            <div class="comment-header">
                                                <span class="comment-author"><%= comment.author_name %></span>
                                                <span class="comment-date"><%= comment.formatted_date %></span>
                                            </div>
                                            <p class="comment-text"><%= comment.content %></p>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p>No comments yet. Be the first to comment!</p>
                            <% } %>
                        </div>
                        
                        <!-- Comment Form -->
                        <div class="comment-form">
                            <h3>Add a Comment</h3>
                            <form action="/projects/<%= project.project_id %>/comment" method="POST">
                                <textarea name="comment" placeholder="Write your comment here..." required></textarea>
                                <button type="submit" class="btn btn-primary">Post Comment</button>
                            </form>
                        </div>
                    </section>
                </div>

                <!-- Right Side (Sidebar) -->
                <div class="sidebar">
                    <!-- Team Members -->
                    <section class="team-members card">
                        <h2>Team Members</h2>
                        <ul class="team-list">
                            <% if (team && team.length > 0) { %>
                                <% team.forEach(member => { %>
                                    <li class="team-member">
                                        <img src="<%= member.profile_pic || '/images/user.jpg' %>" alt="<%= member.name %>" class="member-avatar">
                                        <div class="member-info">
                                            <span class="member-name"><%= member.name %></span>
                                            <span class="member-role"><%= member.role %></span>
                                        </div>
                                    </li>
                                <% }); %>
                            <% } else { %>
                                <li>No team members yet.</li>
                            <% } %>
                        </ul>
                        <% if (team && team.length > 5) { %>
                            <a href="/projects/<%= project.project_id %>/team" class="btn btn-secondary">View Full Team</a>
                        <% } %>
                    </section>

                    <!-- Join Project -->
                    <section class="join-project card">
                        <h2>Join This Project</h2>
                        <% if (isMember) { %>
                            <div class="already-member">You are part of this project</div>
                        <% } else if (hasPendingApplication) { %>
                            <div class="application-pending">Application Pending</div>
                        <% } else if (project.status === 'Open') { %>
                            <p>This project is currently open for new team members.</p>
                            <form action="/projects/<%= project.project_id %>/apply" method="POST">
                                <div class="mb-3">
                                    <textarea name="message" class="form-control" placeholder="Why do you want to join this project? (optional)" rows="3"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-large">Apply Now</button>
                            </form>
                        <% } else { %>
                            <p>This project is not currently accepting new members.</p>
                        <% } %>
                    </section>

                    <!-- Project Actions (for owners) -->
                    <% if (project.owner_id === user.user_id) { %>
                        <section class="project-actions card">
                            <h2>Project Actions</h2>
                            <div class="action-buttons">
                                <a href="/projects/<%= project.project_id %>/edit" class="btn btn-edit"><i class="fas fa-edit"></i> Edit Project</a>
                                <button class="btn btn-danger" onclick="confirmDelete()"><i class="fas fa-trash"></i> Delete Project</button>
                                <button class="btn btn-share" data-bs-toggle="modal" data-bs-target="#shareProjectModal"><i class="fas fa-share-alt"></i> Share Project</button>
                            </div>
                        </section>
                    <% } %>

                    <!-- Add this near the end of the body tag, before the closing </body> -->
                    <script>
                        function confirmDelete() {
                            if (confirm('Are you sure you want to delete this project? This action cannot be undone.')) {
                                fetch('/projects/<%= project.project_id %>/delete', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    credentials: 'same-origin'
                                })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        window.location.href = '/projects';
                                    } else {
                                        alert('Failed to delete project: ' + (data.message || 'Unknown error'));
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    alert('Failed to delete project. Please try again.');
                                });
                            }
                        }
                    </script>
                    <!-- Project Progress -->
                    <section class="project-progress card">
                        <h2>Project Progress</h2>
                        <div class="progress-bar">
                            <div class="progress" style="width: <%= progress %>%"><%= progress %>%</div>
                        </div>
                        
                        <div class="milestone-tracker">
                            <% if (project.milestones && project.milestones.length > 0) { %>
                                <% project.milestones.forEach((milestone, index) => { %>
                                    <div class="milestone <%= project.milestone_status[index] %>">
                                        <div class="milestone-dot"></div>
                                        <div class="milestone-text"><%= milestone %></div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p>No milestones defined.</p>
                            <% } %>
                        </div>
                    </section>
                </div>
            </div>
            
            <!-- Related Projects -->
            <% if (relatedProjects && relatedProjects.length > 0) { %>
                <section class="related-projects">
                    <h2>Related Projects</h2>
                    <div class="projects-carousel">
                        <% relatedProjects.forEach(relatedProject => { %>
                            <div class="project-card">
                                <h3><a href="/projects/<%= relatedProject.project_id %>"><%= relatedProject.title %></a></h3>
                                <p><%= relatedProject.description.substring(0, 100) %>...</p>
                                <div class="project-card-skills">
                                    <% 
                                    let skills = relatedProject.required_skills;
                                    if (typeof skills === 'string') {
                                        skills = JSON.parse(skills);
                                    }
                                    skills.slice(0, 3).forEach(skill => { 
                                    %>
                                        <span class="skill-tag"><%= skill %></span>
                                    <% }); %>
                                    <% if (skills.length > 3) { %>
                                        <span class="skill-tag">+<%= skills.length - 3 %> more</span>
                                    <% } %>
                                </div>
                                <p>By <%= relatedProject.owner_name %></p>
                            </div>
                        <% }); %>
                    </div>
                </section>
            <% } %>
        </div>
    </div>
    
    <!-- Delete Project Modal -->
    <div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this project? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/projects/<%= project.project_id %>/delete" method="POST">
                        <button type="submit" class="btn btn-danger">Delete Project</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Share Project Modal -->
    <div class="modal fade" id="shareProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Share this project with your network:</p>
                    <div class="share-link-container">
                        <input type="text" class="form-control" id="shareLink" value="<%= `${baseUrl}/projects/${project.project_id}` %>" readonly>
                        <button class="btn btn-primary" id="copyLinkBtn"><i class="fas fa-copy"></i> Copy</button>
                    </div>
                    <div class="social-share-buttons mt-3">
                        <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(projectUrl) %>&text=<%= encodeURIComponent(`Check out this project: ${project.title}`) %>" target="_blank" class="btn btn-twitter">
                            <i class="fab fa-twitter"></i> Twitter
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(projectUrl) %>" target="_blank" class="btn btn-linkedin">
                            <i class="fab fa-linkedin"></i> LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Apply to Project Modal -->
    <div class="modal fade" id="applyProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Apply to Join Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/projects/<%= project.project_id %>/apply" method="POST" id="applicationForm">
                        <div class="mb-3">
                            <label for="applicationMessage" class="form-label">Why do you want to join this project?</label>
                            <textarea class="form-control" id="applicationMessage" name="message" rows="4" placeholder="Describe your interest and how you can contribute..."></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit Application</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Copy share link functionality
            const copyLinkBtn = document.getElementById('copyLinkBtn');
            if (copyLinkBtn) {
                copyLinkBtn.addEventListener('click', function() {
                    const shareLink = document.getElementById('shareLink');
                    shareLink.select();
                    document.execCommand('copy');
                    
                    // Change button text temporarily
                    const originalText = copyLinkBtn.innerHTML;
                    copyLinkBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(() => {
                        copyLinkBtn.innerHTML = originalText;
                    }, 2000);
                });
            }
            
            // Apply button functionality
            const applyBtn = document.querySelector('.join-project .btn-primary');
            if (applyBtn) {
                applyBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const applyModal = new bootstrap.Modal(document.getElementById('applyProjectModal'));
                    applyModal.show();
                });
            }
            
            // Project action buttons
            const editBtn = document.querySelector('.btn-edit');
            if (editBtn) {
                editBtn.addEventListener('click', function() {
                    window.location.href = '/projects/<%= project.project_id %>/edit';
                });
            }
            
            // Alert auto-dismiss
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.classList.add('fade');
                    setTimeout(() => {
                        alert.remove();
                    }, 500);
                }, 5000);
            });
            
            // Handle form submissions with AJAX (optional enhancement)
            const commentForm = document.querySelector('.comment-form form');
            if (commentForm) {
                commentForm.addEventListener('submit', function(e) {
                    // You can implement AJAX form submission here if desired
                    // This would prevent page reload when posting comments
                    // For now, we'll let the form submit normally
                });
            }
        });
    </script>
</body>
</html>