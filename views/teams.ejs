            modal.hide();
            
            // In a real app, you would reload the page or update UI
            // window.location.reload();
        }
        
        function updateFilters() {
            // Get filter values
            const category = categoryFilter.value;
            const skill = skillsFilter.value;
            const status = statusFilter.value;
            
            // Clear existing badges
            filterBadges.innerHTML = '';
            
            // Add badges for active filters
            if (category) {
                addFilterBadge('Category', category);
            }
            
            if (skill) {
                addFilterBadge('Skill', skill);
            }
            
            if (status) {
                addFilterBadge('Status', status);
            }
            
            // In a real app, this would filter the teams based on selected criteria
            // For now, we'll just log the filter values
            console.log('Filtering teams by:', { category, skill, status });
        }
        
        function addFilterBadge(type, value) {
            const badge = document.createElement('span');
            badge.className = 'filter-badge';
            badge.innerHTML = `${type}: ${value.charAt(0).toUpperCase() + value.slice(1)} <span class="remove-filter" data-type="${type.toLowerCase()}" data-value="${value}">×</span>`;
            filterBadges.appendChild(badge);
            
            // Add click event to remove filter
            const removeBtn = badge.querySelector('.remove-filter');
            removeBtn.addEventListener('click', function() {
                const filterType = this.getAttribute('data-type');
                
                // Reset the corresponding filter
                if (filterType === 'category') {
                    categoryFilter.value = '';
                } else if (filterType === 'skill') {
                    skillsFilter.value = '';
                } else if (filterType === 'status') {
                    statusFilter.value = '';
                }
                
                // Update filters
                updateFilters();
            });
        }
        
        function searchTeams(query) {
            // In a real app, this would search teams based on the query
            console.log('Searching teams for:', query);
            
            // For demo purposes, we'll just log the search query
            // In a real implementation, you would filter the teams based on the search query
        }
        
        // Fetch projects for the create team form
        function fetchProjects() {
            // In a real app, this would be an AJAX call to get user's projects
            // For demo purposes, we'll add some sample projects
            const projectSelect = document.getElementById('projectSelect');
            
            if (projectSelect) {
                const sampleProjects = [
                    { id: 1, name: 'E-commerce Platform' },
                    { id: 2, name: 'Mobile App Development' },
                    { id: 3, name: 'Data Visualization Dashboard' },
                    { id: 4, name: 'AI Chatbot Integration' }
                ];
                
                sampleProjects.forEach(project => {
                    const option = document.createElement('option');
                    option.value = project.id;
                    option.textContent = project.name;
                    projectSelect.appendChild(option);
                });
            }
        }
        
        // Initialize the page
        fetchProjects();
    });
</script>

