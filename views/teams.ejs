            }
        }
        
        function createNewTeam() {
            // Get form values
            const teamName = document.getElementById('teamName').value;
            const projectId = document.getElementById('projectSelect').value;
            const description = document.getElementById('teamDescription').value;
            
            // Get selected skills
            const skillsSelect = document.getElementById('requiredSkills');
            const selectedSkills = Array.from(skillsSelect.selectedOptions).map(option => option.value);
            
            const maxMembers = document.getElementById('maxMembers').value;
            const isOpen = document.getElementById('openForMembers').checked;
            
            // In a real app, this would be an AJAX call to create the team
            const teamData = {
                teamName,
                projectId,
                description,
                skills: selectedSkills,
