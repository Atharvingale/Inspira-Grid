<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inspira Grid - Find the Right Teammates</title>
    <link rel="stylesheet" href="/css/landing.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="navbar">
      <div class="container">
        <div class="logo-container">
          <img src="/images/logo.png" alt="Inspira Grid" class="logo-img" />
          <span class="logo-text">Inspira Grid</span>
        </div>
        <a href="/signup" class="cta-button">Get Started</a>
        <div class="hamburger">
          <i class="fas fa-bars"></i>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1>Find the Perfect Team for Your Next Big Idea</h1>
          <p>
            Connect with talented students, showcase your skills, and
            collaborate on exciting projects that matter.
          </p>
          <a href="#" class="cta-button">Join Our Community</a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="container">
        <h2 class="section-title">What Makes Us Different</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-users"></i>
            </div>
            <h3>Find Teammates</h3>
            <p>
              Connect with people who have complementary skills and share your
              passion.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-lightbulb"></i>
            </div>
            <h3>List Projects</h3>
            <p>
              Share your ideas and attract collaborators who can help bring them
              to life.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-comments"></i>
            </div>
            <h3>Chat & Collaborate</h3>
            <p>
              Our integrated tools make communication and teamwork seamless.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-tasks"></i>
            </div>
            <h3>Task Management</h3>
            <p>
              Keep your projects organized with our intuitive task management
              system.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works">
      <div class="container">
        <h2 class="section-title">How It Works</h2>
        <div class="steps-container">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Create Your Profile</h3>
            <p>
              Sign up and highlight your skills, experiences, and the projects
              you're interested in.
            </p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Connect & Discover</h3>
            <p>
              Find teammates or projects that match your interests and skillset.
            </p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Collaborate & Succeed</h3>
            <p>
              Work together using our collaboration tools and achieve your
              goals.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials">
      <div class="container">
        <h2 class="section-title">What Students Say</h2>
        <div class="testimonial-container">
          <div class="testimonial-slider">
            <div class="testimonial-card">
              <div class="testimonial-content">
                I was struggling to find developers for my startup idea. Within
                a week on Inspira Grid, I connected with the perfect team
                members who shared my vision. Six months later, we've launched
                our beta and secured initial funding!
              </div>
              <div class="testimonial-author">
                <div class="author-avatar">
                  <img src="/api/placeholder/60/60" alt="Michael Chen" />
                </div>
                <div class="author-info">
                  <h4>Michael Chen</h4>
                  <p>Computer Science, Stanford</p>
                </div>
              </div>
            </div>
          </div>
          <div class="testimonial-controls">
            <div class="control-btn prev">
              <i class="fas fa-arrow-left"></i>
            </div>
            <div class="control-btn next">
              <i class="fas fa-arrow-right"></i>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to Find Your Dream Team?</h2>
          <p>
            Join thousands of students who are already collaborating on
            innovative projects.
          </p>
          <div class="cta-buttons">
            <a href="#" class="cta-button">Sign Up Now</a>
            <a href="#" class="cta-button secondary">Learn More</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-column">
            <h3>About Inspira Grid</h3>
            <ul class="footer-links">
              <li><a href="#">Our Mission</a></li>
              <li><a href="#">Team</a></li>
              <li><a href="#">Careers</a></li>
              <li><a href="#">Blog</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h3>Resources</h3>
            <ul class="footer-links">
              <li><a href="#">Help Center</a></li>
              <li><a href="#">Community Guidelines</a></li>
              <li><a href="#">Success Stories</a></li>
              <li><a href="#">FAQs</a></li>
            </ul>
          </div>
          <div class="footer-column footer-contact">
            <h3>Contact Us</h3>
            <p><i class="fas fa-envelope"></i> support@inspiragrid.com</p>
            <p>
              <i class="fas fa-map-marker-alt"></i> 123 Innovation Drive, San
              Francisco, CA
            </p>
            <div class="social-links">
              <a href="#"><i class="fab fa-facebook-f"></i></a>
              <a href="#"><i class="fab fa-twitter"></i></a>
              <a href="#"><i class="fab fa-instagram"></i></a>
              <a href="#"><i class="fab fa-linkedin-in"></i></a>
            </div>
          </div>
          <div class="footer-column">
            <h3>Stay Updated</h3>
            <p>
              Subscribe to our newsletter for the latest updates and features.
            </p>
            <form class="newsletter-form">
              <input type="email" placeholder="Your email address" />
              <button type="submit"><i class="fas fa-paper-plane"></i></button>
            </form>
          </div>
        </div>
        <div class="copyright">
          &copy; <%= new Date().getFullYear() %> Inspira Grid. All rights
          reserved.
        </div>
      </div>
    </footer>

    <script>
      // Mobile Navigation Toggle
      document.addEventListener("DOMContentLoaded", function () {
        const hamburger = document.querySelector(".hamburger");
        const navMenu = document.querySelector(".nav-menu");

        hamburger.addEventListener("click", () => {
          navMenu.classList.toggle("active");
        });

        // Close menu when link is clicked
        document.querySelectorAll(".nav-menu a").forEach((link) => {
          link.addEventListener("click", () => {
            navMenu.classList.remove("active");
          });
        });

        // Testimonial Slider
        const slider = document.querySelector(".testimonial-slider");
        const prevBtn = document.querySelector(".control-btn.prev");
        const nextBtn = document.querySelector(".control-btn.next");

        // Add more testimonial cards in your actual implementation
        // This is just placeholder functionality
        let slideIndex = 0;

        prevBtn.addEventListener("click", () => {
          // Add slide navigation functionality here
          // This is just a placeholder
          alert("Previous testimonial");
        });

        nextBtn.addEventListener("click", () => {
          // Add slide navigation functionality here
          // This is just a placeholder
          alert("Next testimonial");
        });
      });
    </script>
  </body>
</html>
